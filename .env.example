# Copy to .env to change the defaults. .env is in .gitignore: never commit it.
# Every setting is optional; without a .env the Assist service uses a local
# Ollama server with the models below.

# --- LLM server (node 1) -----------------------------------------------------
# "ollama"        local CPU model through Ollama (default)
# "fake"          canned answers, no model needed (tests, quick demos)
# "openai_compat" any other OpenAI-compatible API (set URL, key and models)
ASSIST_PROVIDER=ollama

# Where Ollama listens. On another machine use its address, e.g.
# http://192.168.1.10:11434/v1 ; in docker-compose it is http://ollama:11434/v1
ASSIST_BASE_URL=http://localhost:11434/v1
ASSIST_API_KEY=ollama

# Pull them first:  ollama pull qwen2.5:3b  and  ollama pull qwen2.5:1.5b
ASSIST_MODEL=qwen2.5:3b
# Used for autocomplete, where speed matters more than quality.
ASSIST_FAST_MODEL=qwen2.5:1.5b

# A CPU model can take a while on long inputs.
ASSIST_DEFAULT_TIMEOUT_S=60

# ASSIST_PORT=50061
# ASSIST_MAX_INPUT_CHARS=8000
# ASSIST_MAX_SUMMARY_CHARS=60000

# --- Gateway -------------------------------------------------------------------
# How long a login token stays valid (seconds). Default: 8 hours.
# GATEWAY_TOKEN_TTL_S=28800
